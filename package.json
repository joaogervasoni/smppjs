{
  "name": "smppjs",
  "version": "1.3.4",
  "description": "Modern approach to smpp protocol.",
  "main": "lib/index.js",
  "types": "lib",
  "scripts": {
    "dev": "tsnd --transpile-only --ignore-watch node_modules --no-notify --respawn src/index.ts",
    "dev:start": "./node_modules/.bin/tsc && node .",
    "dev:build": "./node_modules/.bin/tsc",
    "prod:pack": "npm pack",
    "prod:build": "tsc -p .",
    "lint": "eslint src/**/*.ts"
  },
  "engines": {
    "node": ">=8"
  },
  "author": {
    "name": "João Gervasoni",
    "url": "https://github.com/joaogervasoni"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/joaogervasoni/smppjs"
  },
  "bugs": {
    "url": "https://github.com/joaogervasoni/smppjs/issues"
  },
  "license": "MIT",
  "keywords": [
    "smpp",
    "protocol",
    "smppjs"
  ],
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.9.0",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "17.4.0",
    "prettier": "3.8.1",
    "ts-node-dev": "2.0.0",
    "typescript": "5.4.5",
    "typescript-eslint": "8.56.1"
  }
}
